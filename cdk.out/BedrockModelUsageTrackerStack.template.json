      "",
      [
       "{\"start\":\"-P1D\",\"periodOverride\":\"auto\",\"widgets\":[{\"type\":\"text\",\"width\":24,\"height\":3,\"x\":0,\"y\":0,\"properties\":{\"markdown\":\"# Bedrock Usage Dashboard\\nPer-user monthly budget: **$0.01** across all models. Email alert fires at **80%** of budget.\\n\\nBatch rollup from S3 logs in `s3://708895069383-berock-claude` every **2 minutes**. Per-user spend is exact in DynamoDB (table below); metric graphs are per-model only.\"}},{\"type\":\"metric\",\"width\":12,\"height\":6,\"x\":0,\"y\":3,\"properties\":{\"view\":\"timeSeries\",\"title\":\"Total tokens (sum, 5m)\",\"region\":\"",
